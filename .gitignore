# =============================================================================
# omes-dgw 根仓库：忽略构建产物、本地运行时数据、IDE / OS 文件
# =============================================================================

# --- Maven / Java 构建 ---
**/target/
dependency-reduced-pom.xml
*.class
*.jar
!**/maven-wrapper.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# --- 前端（omes-dgw-web）---
**/node_modules/
**/dist/
**/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 盒子门户：勿提交内嵌构建产物（由 Maven 写入 target/classes/static）---
omes-dgw-portal-box/src/main/resources/static/

# --- 本地运行时（JAR 同级工作目录）---
/logs/
/data/

# --- 本地密钥与环境文件（保留 *.example）---
.env
**/.env
!**/.env.example
*.pem
*.key

# --- IDE / 编辑器 ---
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# --- 操作系统 ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- 日志与临时文件 ---
*.log
*.tmp
*.bak
*.orig
.cache/
