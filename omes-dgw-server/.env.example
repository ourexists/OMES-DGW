# 复制为 .env 后按需修改：cp .env.example .env  （Windows: copy .env.example .env）

# --- 采集存储后端 ---
# caffeine（默认）无需 Redis；redis 需将 omes-dgw-plugin-redis 插件 jar 加入 classpath 后设 COLLECT_STORE_BACKEND=redis
COLLECT_STORE_BACKEND=caffeine
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DATABASE=0

# --- SQLite（业务关系库，本地文件；容器内建议挂载 /app/data）---
SQLITE_PATH=./data/omes-dgw.db
FLYWAY_ENABLED=true

# --- InfluxDB 2.x（与 docker-compose 中 influxdb 初始化一致）---
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=admin123456
INFLUX_ORG=omes
INFLUX_BUCKET=collect_metrics
INFLUX_ADMIN_TOKEN=collect-dev-influx-token-change-me

# --- 多服务 CORS（与 113-manage 共用，逗号分隔）---
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://192.168.*:*

# --- 应用 JVM（可选）---
# JAVA_OPTS=-Xms512m -Xmx1024m
