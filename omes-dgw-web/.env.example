# 采集 API（omes-dgw-server，默认 12010）
# 开发直连后端用完整 URL；盒子内嵌构建用 /（见 .env.box）；中控 Nginx 用 /api（见 .env.production）
VITE_API_BASE_URL=http://localhost:12020/
VITE_COLLECT_API_BASE_URL=http://localhost:12020/

# 管理平台 API（113-manage，默认 10090；接入 OAuth2 登录时使用）
VITE_MANAGE_API_BASE_URL=http://localhost:10090/

VITE_LOGIN_USERNAME=admin
VITE_LOGIN_PASSWORD=admin123
