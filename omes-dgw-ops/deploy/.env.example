# 复制为 .env 后按现场修改：copy .env.example .env

MOUNT_PATH=D:/docker/omes-dgw

# --- 中间件：客户现场已安装 Influx 时保持 false（默认）---
# 若由本 compose 拉起 Influx 容器，改为 true
USE_BUNDLED_INFLUX=false

# --- 外部 InfluxDB 2.x（USE_BUNDLED_INFLUX=false 时生效）---
# 首次可运行 02-初始化InfluxDB.bat，将 influx-app-credentials.env 中的 INFLUX_* 粘贴到此处
# INFLUX_URL 须能从 omes-dgw-server 容器访问；token/org/bucket 与客户实例一致
INFLUX_URL=http://host.docker.internal:8086
INFLUX_ADMIN_TOKEN=collect-dev-influx-token-change-me
INFLUX_ORG=omes
INFLUX_BUCKET=collect_metrics
# 采集监控类型：none（无，默认）、influxdb
COLLECT_MONITOR_TYPE=none

# --- 由 compose 自带 Influx 时（USE_BUNDLED_INFLUX=true）可改用下面地址 ---
# INFLUX_URL=http://influxdb:8086
# 且 INFLUX_ADMIN_* 须与下方初始化参数一致（仅首次空库初始化时有效）

# --- 自带 Influx 初始化（仅 profile bundled-influx 首次建库）---
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=admin123456

# --- SQLite（业务库文件，挂载在 MOUNT_PATH/omes-dgw/data）---
# 容器内默认路径；宿主机对应 ${MOUNT_PATH}/omes-dgw/data/omes-dgw.db
SQLITE_PATH=/app/data/omes-dgw.db
FLYWAY_ENABLED=true

# --- 发布端口 ---
APP_PUBLISH_PORT=12010
INFLUX_PUBLISH_PORT=8086
FRONT_PUBLISH_PORT=12011

# --- 采集存储（可选 Redis）---
# 默认 caffeine 本地缓存/队列。启用 Redis：导入 omes-dgw-plugin-redis 插件 jar，再设：
# COLLECT_STORE_BACKEND=redis
# REDIS_HOST=host.docker.internal
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DATABASE=0

CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
